{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "veya-desktop",
  "version": "0.1.0",
  "identifier": "com.veya.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash ../../scripts/build-desktop-web.sh",
    "frontendDist": "../../web/build-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Veya — AI 编码 Agent",
        "width": 1360,
        "height": 860,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/backend/veya-backend": "backend/veya-backend"
    }
  }
}
