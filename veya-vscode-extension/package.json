{
    "name": "veya-vscode",
    "displayName": "veya - AI编程助手",
    "description": "基于veya的AI编程助手，提供代码生成、补全和分析功能",
    "version": "0.1.0",
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:python",
        "onLanguage:javascript",
        "onLanguage:typescript",
        "onCommand:veya.generateCode",
        "onCommand:veya.completeCode",
        "onCommand:veya.analyzeCode"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "veya.generateCode",
                "title": "veya: 生成代码"
            },
            {
                "command": "veya.completeCode",
                "title": "veya: 代码补全"
            },
            {
                "command": "veya.analyzeCode",
                "title": "veya: 分析代码"
            },
            {
                "command": "veya.collaborateTask",
                "title": "veya: 协作任务"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "veya.generateCode",
                    "when": "editorHasSelection",
                    "group": "navigation"
                },
                {
                    "command": "veya.completeCode",
                    "when": "editorTextFocus",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "postinstall": "node ./node_modules/vscode/bin/install"
    },
    "devDependencies": {
        "@types/vscode": "^1.70.0",
        "@types/glob": "^7.2.0",
        "@types/node": "^16.11.7",
        "typescript": "^4.4.4",
        "vscode": "^1.1.37",
        "vscode-test": "^1.5.2"
    },
    "dependencies": {
        "vscode": "^1.1.37"
    }
}