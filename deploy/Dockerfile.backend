# veya Backend Dockerfile — Agent OS 后端(9 大能力 + 3O 主库)
FROM node@sha256:813a7480f28fdadac1f7f5c824bcdad435b5bc1322a5968bbbdef8d058f9dff4 AS hicode_node_runtime
FROM python:3.14-slim

WORKDIR /app

# Install system deps (rg 供 grep 工具; git 供推库; playwright 浏览器可选)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ripgrep build-essential python3-dev \
    # Playwright Chromium 运行库 (无头浏览器抓取通道)
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 \
    libasound2 libpango-1.0-0 libcairo2 libmagic1 \
    && rm -rf /var/lib/apt/lists/*

# Python 依赖(从 pyproject 全量安装, 含 apscheduler/pandas/numpy/pyarrow/scipy/cryptography)
COPY veya/ ./veya/
COPY server/ ./server/
COPY runtime/ ./runtime/
COPY platform/ ./platform/
COPY tests/ ./tests/
COPY services/ ./services/
COPY infra/ ./infra/
COPY veya_loop/ ./veya_loop/
# Agent OS 顶层包 — 逐目录 COPY (多源目录 COPY 会摊平文件到根, 遮蔽 stdlib)
COPY agents/ ./agents/
COPY cli/ ./cli/
COPY commands/ ./commands/
COPY config/ ./config/
COPY hooks/ ./hooks/
COPY projects/ ./projects/
COPY registries/ ./registries/
COPY security/ ./security/
COPY session/ ./session/
COPY streaming/ ./streaming/
COPY tools/ ./tools/
COPY tui/ ./tui/
COPY pyproject.toml README.md ./
# 3O 主库 heavy-SDK 依赖 (oprim eager 导出 / omodul eager 装配所需)
# 运行时依赖全量 (含 3O 主库 heavy-SDK: tree-sitter/pgmpy/rapidfuzz/chardet 等)
COPY deploy/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
# Managed HiCode runtime: install the exact Reasonix package from the checked-in
# npm lockfile. The Python wheel intentionally does not carry Node/Reasonix;
# this server image is the supported production artifact.
COPY --from=hicode_node_runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=hicode_node_runtime /usr/local/bin/npm /usr/local/bin/npm
COPY --from=hicode_node_runtime /usr/local/bin/npx /usr/local/bin/npx
COPY --from=hicode_node_runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
# The Node image keeps npm/npx as symlinks.  Docker COPY dereferences those
# links, so restore the links after copying the npm tree or their relative
# CLI imports resolve from /usr/local/bin instead of the npm package root.
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
COPY deploy/hicode-runtime/package.json deploy/hicode-runtime/package-lock.json /opt/veya/hicode-runtime/
RUN npm ci --prefix /opt/veya/hicode-runtime --omit=dev --ignore-scripts \
    && /opt/veya/hicode-runtime/node_modules/.bin/reasonix --version \
      | grep -Fx 'reasonix v1.21.3'
# DSH (DeepSeek Harness) executor — the shell/ops execution plane. Pinned exact
# version, installed from a checked-in lockfile. DSH holds NO provider
# credential: it talks to the Veya LLM gateway (see server/dsh_plane.py).
COPY deploy/dsh-runtime/package.json deploy/dsh-runtime/package-lock.json /opt/veya/dsh-runtime/
RUN npm ci --prefix /opt/veya/dsh-runtime --omit=dev --ignore-scripts \
    && ln -sfn /opt/veya/dsh-runtime/node_modules/.bin/dsh /usr/local/bin/dsh \
    && dsh --help >/dev/null \
    && which dsh
# 3O 主库装配通道 is part of the server-image contract, not a host PATH hack.
ENV PYTHONPATH=/app:/app/services:/app/platform/3O/oprim:/app/platform/3O/oskill:/app/platform/3O/omodul:/app/platform/3O/obase:/app/platform/3O/oservi
ENV VEYA_WORKSPACE=/app
# Playwright 浏览器二进制 (随构建 context 分发, 免 CDN 网络下载)
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
# Create the runtime user before copying the browser bundle so ownership is
# assigned in the copy layer.  A recursive chmod over this 656 MB tree makes
# image export unnecessarily expensive and creates a second full-size layer.
RUN useradd -m -u 1000 soffy
# Docker copies this directory into a newly-created named volume on first
# mount; keep the managed Veya data root writable by the runtime user.
RUN install -d -o soffy -g soffy \
    /home/soffy/.veya \
    /home/soffy/.veya/hicode-runtime \
    /home/soffy/.veya/hicode-workspace
COPY --chown=soffy:soffy deploy/ms-playwright/ /opt/ms-playwright/
COPY LICENSE ./
RUN pip install --no-cache-dir . && pip install --no-cache-dir -e ./veya_loop \
    && python -c "import types, chardet, server.app; print('[build] server.app imports OK')"

ENV HICODE_MANAGED_RUNTIME_ROOT=/opt/veya/hicode-runtime \
    HICODE_RUNTIME_DATA_ROOT=/home/soffy/.veya/hicode-runtime \
    HICODE_PRODUCTION=1
# 容器内无 user namespace: Chromium 自身 sandbox 关闭 (见 veya/oskill/browser.py)
ENV VEYA_BROWSER_NO_SANDBOX=1

# 多引擎执行: 与宿主 uid 对齐 (挂载的 CLI 凭据可写), 非 root 运行
USER soffy
ENV HOME=/home/soffy \
    PATH=/usr/local/bin:/usr/bin:/bin:/opt/veya/hicode-runtime/node_modules/.bin:/home/soffy/.nvm/versions/node/v26.4.0/bin:/home/soffy/.local/bin

EXPOSE 8765

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -sf http://localhost:8765/health || exit 1

CMD ["uvicorn", "server.app:app", "--host", "0.0.0.0", "--port", "8765"]
