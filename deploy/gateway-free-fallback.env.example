# Example only: copy the single VEYA_GATEWAY_FAILOVER assignment into the
# existing .env consumed by deploy/docker-compose.yml's veya-llm-gateway
# service. Do not install this example as an env_file (that would enable it by
# default). Empty/unset VEYA_GATEWAY_FAILOVER keeps current routing unchanged.
#
# The two cliproxy/<model> names are resolved from CLIProxyAPI's /v1/models
# catalogue at gateway startup. Confirm both IDs are present and assigned to
# the free quota/tier in the current CLIProxyAPI account before enabling.
# Free-pool discovery remains enabled: deliberately do not set
# VEYA_FREE_POOL_STATIC, because it replaces the discovered pool.
# No API keys or tokens belong in this file.
VEYA_GATEWAY_FAILOVER=veya1.2:veya-free,veya-fllm,veya-wb,cliproxy/gemini-3-flash,cliproxy/gemini-3.5-flash-lite;veya1.2-flash:veya-free,veya-fllm,veya-wb,cliproxy/gemini-3-flash,cliproxy/gemini-3.5-flash-lite;veya1.2-free:veya-fllm,veya-wb,cliproxy/gemini-3-flash,cliproxy/gemini-3.5-flash-lite;veya-free:veya-fllm,veya-wb,cliproxy/gemini-3-flash,cliproxy/gemini-3.5-flash-lite;veya-fllm:veya-wb,cliproxy/gemini-3-flash,cliproxy/gemini-3.5-flash-lite;veya-wb:veya-fllm,cliproxy/gemini-3-flash,cliproxy/gemini-3.5-flash-lite
