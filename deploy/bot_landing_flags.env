# Production flag set for Veya Bot Landing (BOT_LANDING_W11_SPEC.md)
# Committed, no secrets. Wires the full always-on feature set into the prod container.
VEYA_TURN_QUEUE=1
VEYA_WAKE_ROUTER=1
VEYA_LOOP_MODE=1
VEYA_FINISH_CHECKPOINT=1
VEYA_LIVE_STREAM=1
VEYA_PROMPT_CACHE=1
VEYA_CONTEXT_STEWARD=1
VEYA_MEMORY_REVIEW=1
VEYA_READ_OWN_CHAT=1
VEYA_BOT_MEMORY_MD=1
VEYA_PERSISTENT_WORKERS=1
VEYA_AUTO_REVIEW=1
VEYA_GROUP_ROLES=1
VEYA_BOT_SECRETS=1
VEYA_A11Y_FIRST=1
VEYA_DOM_READER=1
VEYA_CHANNEL_LADDER=1
VEYA_TOOL_ERROR_FRIENDLY=1
VEYA_SEARCH_FALLBACK=1
VEYA_CHANNEL_STATUS=1
VEYA_APPROVAL_GATES=1
# Routine clock (schedule.trigger source) — routines must fire on their own (S6).
VEYA_ROUTINE_CLOCK=1
# Model calls with ~180 tool schemas can exceed 30s; a lease that short goes stale mid-turn (STALE_FENCE).
VEYA_EXECUTION_LEASE_TTL_S=300
VEYA_EXECUTION_HEARTBEAT_INTERVAL_S=20
VEYA_SUPERVISOR=1
VEYA_BRAIN_BREAKER=1
# fixall 2026-10-14: wire the surfaces that were shipped but left dark (endpoints 404'd in prod).
# W13 remote control (/api/v1/remote/*), W14 MCP preset pack (/api/v1/mcp-presets),
# NANO-W7 channels (/api/v1/channels/*), NANO-W8 provider registry (/api/v1/providers/*).
VEYA_REMOTE_CONTROL=1
VEYA_MCP_PRESETS=1
VEYA_CHANNELS=1
VEYA_PROVIDER_REGISTRY=1

# ─────────────────────────────────────────────────────────────────────
# ALLON 2026-10-14: turn on the remaining default-OFF feature switches.
# Each is either already fully wired (backend route + frontend entry, hidden by
# flag) or a backend-only behavior (no UI needed). See ALLON_INVENTORY.md.
# ─────────────────────────────────────────────────────────────────────

# W15 role & skill preset pack (REST /api/v1/presets/* + bot presets apply;
# frontend PresetPicker auto-shows when on). No new tool, no secrets.
VEYA_ROLE_SKILL_PRESETS=1

# W16 Project Brain (REST /api/v1/projects/*; frontend /projects auto-shows).
VEYA_PROJECT_BRAIN=1

# W17 SSH host execution backend (under VEYA_REMOTE_CONTROL; frontend /remote).
VEYA_SSH_HOSTS=1

# W17 session-scoped ask-once approval cache (backend dedup; transparent, no UI).
VEYA_APPROVAL_ASK_ONCE=1

# FastClaw clean-room: fork + explicit per-bot public chat link (owner toggles
# each bot; guest isolation stays enforced via channels/sandbox_enforce.py).
VEYA_BOT_PUBLIC_SHARE=1

# FastClaw clean-room: IM / public-chat sandbox enforcement (tightens non-owner
# exec/file/secret tools; owner turns & flag-off are unchanged).
VEYA_IM_SANDBOX_ENFORCE=1

# OpenMinis clean-room: progressive skill disclosure (prompt-injected; no UI).
VEYA_SKILL_PROGRESSIVE=1

# OpenMinis clean-room: veya:// workspace virtual URI (fs layer; no UI).
VEYA_WORKSPACE_URI=1

# OpenMinis clean-room: user-global memory context injected into turns (no UI).
VEYA_MEMORY_UI=1

# W18 DeepEval optional judge backend. FLAG ON, but the `deepeval` package is
# NOT installed in the shared .venv (do not pip install it here). When missing,
# server/deepeval_adapter.available()==False and the supervisor path no-ops
# gracefully (UI/report show "未安装"). No keys, no cost.
VEYA_DEEPEVAL=1

# W20 Tailnet channel (owner-only REST /api/v1/tailnet/*; no frontend per spec).
# Listener binds ONLY the verified Tailscale IP (never 0.0.0.0), port 7767,
# fail-closed if Tailscale identity/IP unavailable. Default policy is deny-all
# (allowlist empty) — the owner seeds the single allowed peer after enabling:
#   PUT /api/v1/tailnet/policy  {"mode":"allowlist","allow":["user:soffy88@gmail.com"]}
# which permits only the same Tailscale login (deny takes precedence).
# Owner identity: management routes accept any request carrying is_owner/is_admin,
# or a user_id matching VEYA_TAILNET_OWNER_USER_ID / VEYA_OWNER_USER_ID below.
# Set the owner id to the deploying owner's user_id from the auth DB if you want
# to restrict strictly to one account (read-only; do not bake a random uuid).
# VEYA_TAILNET_OWNER_USER_ID=
VEYA_TAILNET_CHANNEL=1
VEYA_TAILNET_PORT=7767
