# Production flag set for Veya Bot Landing (BOT_LANDING_W11_SPEC.md)
# Committed, no secrets. Wires the full always-on feature set into the prod container.
VEYA_TURN_QUEUE=1
VEYA_WAKE_ROUTER=1
VEYA_LOOP_MODE=1
VEYA_FINISH_CHECKPOINT=1
VEYA_LIVE_STREAM=1
VEYA_PROMPT_CACHE=1
VEYA_CONTEXT_STEWARD=1
VEYA_MEMORY_REVIEW=1
VEYA_READ_OWN_CHAT=1
VEYA_BOT_MEMORY_MD=1
VEYA_PERSISTENT_WORKERS=1
VEYA_AUTO_REVIEW=1
VEYA_GROUP_ROLES=1
VEYA_BOT_SECRETS=1
VEYA_A11Y_FIRST=1
VEYA_DOM_READER=1
VEYA_CHANNEL_LADDER=1
VEYA_TOOL_ERROR_FRIENDLY=1
VEYA_SEARCH_FALLBACK=1
VEYA_CHANNEL_STATUS=1
VEYA_APPROVAL_GATES=1
# Routine clock (schedule.trigger source) — routines must fire on their own (S6).
VEYA_ROUTINE_CLOCK=1
# Model calls with ~180 tool schemas can exceed 30s; a lease that short goes stale mid-turn (STALE_FENCE).
VEYA_EXECUTION_LEASE_TTL_S=300
VEYA_EXECUTION_HEARTBEAT_INTERVAL_S=20
VEYA_SUPERVISOR=1
VEYA_BRAIN_BREAKER=1
# fixall 2026-10-14: wire the surfaces that were shipped but left dark (endpoints 404'd in prod).
# W13 remote control (/api/v1/remote/*), W14 MCP preset pack (/api/v1/mcp-presets),
# NANO-W7 channels (/api/v1/channels/*), NANO-W8 provider registry (/api/v1/providers/*).
VEYA_REMOTE_CONTROL=1
VEYA_MCP_PRESETS=1
VEYA_CHANNELS=1
VEYA_PROVIDER_REGISTRY=1
