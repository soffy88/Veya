{
  "name": "@helios/blocks",
  "version": "3.0.0",
  "description": "Wiki Block System: Helios 项目群前端 UI 范式 (Block / Frame / Theme)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./themes/cyberpunk.css": "./dist/themes/cyberpunk.css",
    "./themes/professional.css": "./dist/themes/professional.css",
    "./themes/academic.css": "./dist/themes/academic.css",
    "./themes/terminal-dark.css": "./dist/themes/terminal-dark.css",
    "./themes/terminal-light.css": "./dist/themes/terminal-light.css",
    "./themes/terminal-neon.css": "./dist/themes/terminal-neon.css",
    "./themes/terminal-paper.css": "./dist/themes/terminal-paper.css",
    "./themes/zen.css": "./dist/themes/zen.css",
    "./dist/styles.css": "./dist/styles.css",
    "./dist/themes/academic.css": "./dist/themes/academic.css",
    "./themes/base.css": "./dist/themes/base.css",
    "./dist/themes/base.css": "./dist/themes/base.css",
    "./dist/themes/cyberpunk.css": "./dist/themes/cyberpunk.css",
    "./themes/index.css": "./dist/themes/index.css",
    "./dist/themes/index.css": "./dist/themes/index.css",
    "./themes/mneme-friendly.css": "./dist/themes/mneme-friendly.css",
    "./dist/themes/mneme-friendly.css": "./dist/themes/mneme-friendly.css",
    "./dist/themes/professional.css": "./dist/themes/professional.css",
    "./dist/themes/terminal-dark.css": "./dist/themes/terminal-dark.css",
    "./themes/terminal-density.css": "./dist/themes/terminal-density.css",
    "./dist/themes/terminal-density.css": "./dist/themes/terminal-density.css",
    "./dist/themes/terminal-light.css": "./dist/themes/terminal-light.css",
    "./dist/themes/terminal-neon.css": "./dist/themes/terminal-neon.css",
    "./dist/themes/terminal-paper.css": "./dist/themes/terminal-paper.css",
    "./themes/tide-bloomberg.css": "./dist/themes/tide-bloomberg.css",
    "./dist/themes/tide-bloomberg.css": "./dist/themes/tide-bloomberg.css",
    "./themes/typography.css": "./dist/themes/typography.css",
    "./dist/themes/typography.css": "./dist/themes/typography.css",
    "./dist/themes/zen.css": "./dist/themes/zen.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && node scripts/inject-use-client.mjs && npm run build:css",
    "build:css": "npx @tailwindcss/cli -i ./src/themes/index.css -o ./dist/styles.css --minify && node scripts/build-themes.mjs",
    "build:themes": "node scripts/build-themes.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm run build && changeset publish",
    "prepublishOnly": "pnpm run build && pnpm run test && pnpm run typecheck",
    "build:use-client": "node scripts/inject-use-client.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.4.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.20.0",
    "@tanstack/react-virtual": "^3.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hls.js": "^1.6.16",
    "katex": "^0.17.0",
    "lightweight-charts": "^5.0.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.39.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.1",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.3",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "optionalDependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-themes": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.4.1",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.14.0",
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiki-helios/blocks.git"
  },
  "keywords": [
    "ui",
    "react",
    "tailwind",
    "helios",
    "wiki",
    "design-system",
    "block-system"
  ],
  "author": "Wiki",
  "license": "UNLICENSED"
}
