import { ComponentType } from 'react';

/**
 * PageMeta — OUI 中性路由描述格式。
 *
 * 设计原则:
 *   - 不绑定任何路由库(Next.js / React Router / TanStack Router)
 *   - 项目用 5 行 glue 代码转换成自家路由格式
 *   - 元数据齐全:layout / requireAuth / icon / breadcrumb / title
 *
 * 项目可以:
 *   1. 全部导入: const allPages = [...authPages, ...settingsPages, ...errorPages]
 *   2. 按需挑: const myAuth = [authPages.find(p => p.id === 'login')]
 *   3. 完全忽略 PageMeta 直接 import { OLoginPage } 自行装配
 */

/** OUI 内置 Layout 类型 — 项目可扩展为自定义字符串。 */
type LayoutKind = 'app' | 'auth' | 'minimal' | 'fullscreen' | (string & {});
interface PageMeta {
    /** 唯一稳定 ID(跨版本不变),用于查找 / 删除 / 替换。 */
    id: string;
    /** 标准路径(供项目转换);不包含 query / hash。 */
    path: string;
    /** Page 组件(已 default-exported,无需 props 即可渲染)。 */
    component: ComponentType<unknown>;
    /** Layout 标识(项目据此包不同 AppShell / AuthShell)。 */
    layout: LayoutKind;
    /** 是否需要登录态(false = 公开)。项目自己实现守卫。 */
    requireAuth: boolean;
    /** 浏览器 title(可被 i18n 覆盖)。 */
    title: string;
    /** 侧边栏图标(emoji / icon name,渲染由项目决定)。 */
    icon?: string;
    /** 面包屑标签(若与 title 不同)。 */
    breadcrumb?: string;
    /** 角色要求(项目自实现 RBAC,OUI 仅声明)。 */
    roles?: string[];
    /** 自由元数据(项目业务字段)。 */
    meta?: Record<string, unknown>;
}
/** 工具:从 PageMeta[] 中按 id 找一项。 */
declare function findPage(pages: PageMeta[], id: string): PageMeta | undefined;
/** 工具:从 PageMeta[] 中删除指定 id 的页面(返回新数组)。 */
declare function omitPages(pages: PageMeta[], ids: string[]): PageMeta[];
/** 工具:替换某个 page 的字段(返回新数组)。 */
declare function patchPage(pages: PageMeta[], id: string, patch: Partial<PageMeta>): PageMeta[];

/**
 * OUI Routes Catalog — 中性 PageMeta[] 集合。
 *
 * 项目按需引入(各组独立,可拼可挑可删):
 *
 *   import { authPages, errorPages, settingsPages, adminPages } from '@helios/oui/routes';
 *
 *   // 全部接入
 *   const allOUIPages = [...authPages, ...errorPages, ...settingsPages, ...adminPages];
 *
 *   // 按需挑
 *   const myAuth = authPages.filter(p => p.id !== 'signup'); // 不要 signup
 *
 *   // 转换成 React Router 格式
 *   const routes = allOUIPages.map(p => ({ path: p.path, element: <p.component /> }));
 *
 *   // 转换成 Next.js App Router(在 app/{path}/page.tsx 中):
 *   //   export { default } from '@helios/oui/pages/OLoginPage';
 */

/** 认证页(Login / Signup / Forgot)。布局: auth(居中卡片)。 */
declare const authPages: PageMeta[];
/** 错误页(404 / 403 / 错误兜底 / 维护)。布局: fullscreen / minimal。 */
declare const errorPages: PageMeta[];
/** 设置页(单页内部分 tab)。布局: app。需登录。 */
declare const settingsPages: PageMeta[];
/** 管理页(成员 / 审计)。布局: app。需登录 + admin 角色。 */
declare const adminPages: PageMeta[];
/** 引导页(初次登录)。布局: minimal。需登录。 */
declare const onboardingPages: PageMeta[];
/** 所有 OUI 页面(快捷:项目全量引入用)。 */
declare const allOUIPages: PageMeta[];

export { type LayoutKind, type PageMeta, adminPages, allOUIPages, authPages, errorPages, findPage, omitPages, onboardingPages, patchPage, settingsPages };
