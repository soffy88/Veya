{
  "openapi": "3.1.0",
  "info": {"version": "0.1.0"},
  "paths": {
    "/.well-known/cfkanban-instance.json": {"get": {"operationId": "discoverInstance"}},
    "/healthz": {"get": {"operationId": "getHealth"}},
    "/api/v1/meta": {"get": {"operationId": "getMeta"}},
    "/api/v1/me": {"get": {"operationId": "getMe"}},
    "/api/v1/workspaces/{workspace_id}/projects": {"get": {"operationId": "listProjects"}},
    "/api/v1/workspaces/{workspace_id}/projects/{project_id}": {"get": {"operationId": "getProject"}},
    "/api/v1/issues": {"get": {"operationId": "listIssues"}},
    "/api/v1/workspaces/{workspace_id}/projects/{project_id}/issues": {"get": {"operationId": "listProjectIssues"}},
    "/api/v1/issues/{identifier}": {"get": {"operationId": "getIssue"}},
    "/api/v1/issues/{identifier}/comments": {"get": {"operationId": "listComments"}, "post": {"operationId": "createComment"}},
    "/api/v1/events": {"get": {"operationId": "listEvents"}},
    "/api/v1/issues/{identifier}/commands/assign-to-me": {"post": {"operationId": "assignIssueToMe"}},
    "/api/v1/issues/{identifier}/commands/report-blocked": {"post": {"operationId": "reportIssueBlocked"}},
    "/api/v1/issues/{identifier}/commands/clear-blocked": {"post": {"operationId": "clearIssueBlocked"}},
    "/api/v1/issues/{identifier}/commands/complete": {"post": {"operationId": "completeIssue"}},
    "/api/v1/issues/{identifier}": {"get": {"operationId": "getIssue"}, "patch": {"operationId": "updateIssue"}}
  }
}
